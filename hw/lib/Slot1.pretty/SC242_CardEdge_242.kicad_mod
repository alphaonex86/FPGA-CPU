(footprint "SC242_CardEdge_242" (layer "F.Cu")
	(descr "SC242 card-edge plug (Slot 1, 2x121, 1.0 mm pitch). Origin: pad A1/B1 center (0.157 in from the card end per 243397-02 Fig 1); stations 0..120 mm at 1.0 mm pitch along X along a 5.000 in (127.0 mm) substrate; contact pad rows on F.Cu (A) and B.Cu (B) both at local Y +1.75 mm with pad faces flush with the PCB edge (tips at Y 0), i.e. both faces' fingers run inboard from the insertion edge plane. PCB edge to be milled with the 2 mm key notch between stations 73/74 (courtyard/fab line). Substrate thickness 1.57 mm +0.18/-0.13 (243397-02 Fig 1). From the connector drawing; exact pad/key geometry pending plan slot1 D16 (operator measurement).")
	(tags "slot1 SC242 card-edge 2x121 1mm")
	(attr exclude_from_pos_files exclude_from_bom)
		(fp_text reference "REF**" (at 0 6.750000 unlocked) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
		(fp_text value "SC242_CardEdge_242" (at 0 -6.750000 unlocked) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
