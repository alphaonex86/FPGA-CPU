--- a/src/main/scala/vexiiriscv/decode/Decode.scala
+++ b/src/main/scala/vexiiriscv/decode/Decode.scala
@@ -34,7 +34,8 @@ object Decode extends AreaObject {
   val STORE_ID = Payload(UInt(STORE_ID_WIDTH bits))
   def laneIds = 0 until LANES
 
-  def INSTRUCTION_SLICE_COUNT_MAX = INSTRUCTION_WIDTH / Fetch.SLICE_WIDTH
+  val INSTRUCTION_SLICES_MAX = blocking[Int] // set by the ISA plugin (x86: 15 byte slices)
